<?xml version="1.0" encoding="utf-8" standalone="no"?>
<placeable type="bunkerSilo" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_gbwCompostBay</name>
        <functions>
            <function>$l10n_function_gbwCompostBay</function>
        </functions>
        <image>$moddir$FS25_orchardsAndGreenhouses_crossplay/placeables/compostSilo/store_compostSilo.dds</image>
        <price>45000</price>
        <dailyUpkeep>8</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>silos</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>gbwBgaCompatibility</tab>
        </brush>
    </storeData>

    <base>
        <filename>$moddir$FS25_orchardsAndGreenhouses_crossplay/placeables/compostSilo/compostSilo.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true" placementPositionSnapSize="0.5" placementRotationSnapAngle="90">
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End"/>
        </testAreas>
        <sounds>
            <place template="smallImp"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="5" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="levelArea1Start" widthNode="levelArea1Width" heightNode="levelArea1Height" groundType="concrete"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
        </updateAreas>
    </ai>

    <bunkerSilo isExtendable="true" siloToSiloDistance="9.5" snapDistance="14" acceptedFillTypes="ORGANICWASTE GRASS_WINDROW DRYGRASS_WINDROW STRAW POTATO SUGARBEET SUGARBEET_CUT BEETROOT CARROT PARSNIP GREENBEAN PEA SPINACH SUGARCANE GRAPE OLIVE MANURE" inputFillType="ORGANICWASTE" outputFillType="COMPOST" distanceToCompactedFillLevel="999" openingLength="20">
        <area startNode="siloAreaStart" widthNode="siloAreaWidth" heightNode="siloAreaHeight"/>
        <innerArea startNode="siloInnerAreaStart" widthNode="siloInnerAreaWidth" heightNode="siloInnerAreaHeight"/>
        <interactionTrigger node="siloTrigger"/>
        <wallLeft node="wallLeft" collision="wallLeftCollision"/>
        <wallRight node="wallRight" collision="wallRightCollision"/>
    </bunkerSilo>

    <i3dMappings>
        <i3dMapping id="siloAreaStart" node="0>0|0|0"/>
        <i3dMapping id="siloAreaWidth" node="0>0|0|1"/>
        <i3dMapping id="siloAreaHeight" node="0>0|0|2"/>
        <i3dMapping id="siloTrigger" node="0>0|0|3"/>
        <i3dMapping id="siloInnerAreaStart" node="0>0|1|0"/>
        <i3dMapping id="siloInnerAreaWidth" node="0>0|1|1"/>
        <i3dMapping id="siloInnerAreaHeight" node="0>0|1|2"/>
        <i3dMapping id="wallLeft" node="0>0|2|1"/>
        <i3dMapping id="wallRight" node="0>0|2|2"/>
        <i3dMapping id="clearArea1Start" node="0>1|0"/>
        <i3dMapping id="clearArea1Width" node="0>1|0|0"/>
        <i3dMapping id="clearArea1Height" node="0>1|0|1"/>
        <i3dMapping id="levelArea1Start" node="0>2|0"/>
        <i3dMapping id="levelArea1Width" node="0>2|0|0"/>
        <i3dMapping id="levelArea1Height" node="0>2|0|1"/>
        <i3dMapping id="indoorArea1Start" node="0>3|0"/>
        <i3dMapping id="indoorArea1Width" node="0>3|0|0"/>
        <i3dMapping id="indoorArea1Height" node="0>3|0|1"/>
        <i3dMapping id="testArea1Start" node="0>4|0"/>
        <i3dMapping id="testArea1End" node="0>4|0|0"/>
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>5|0"/>
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>5|0|0"/>
        <i3dMapping id="wallLeftCollision" node="0>6|1"/>
        <i3dMapping id="wallRightCollision" node="0>6|2"/>
    </i3dMappings>
</placeable>
