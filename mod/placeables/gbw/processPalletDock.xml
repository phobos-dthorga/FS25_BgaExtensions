<?xml version="1.0" encoding="utf-8" standalone="no"?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_gbwProcessPalletDock</name>
        <functions>
            <function>$l10n_function_gbwProcessPalletDock</function>
        </functions>
        <image>$data/placeables/shared/sellingStationGeneric/store_sellingStationGeneric.dds</image>
        <price>20000</price>
        <dailyUpkeep>5</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>LIZARD</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>gbwBgaProduction</tab>
        </brush>
    </storeData>

    <base>
        <filename>$data/placeables/shared/sellingStationGeneric/sellingStationProducts.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true"/>
    <clearAreas/>
    <leveling/>

    <indoorAreas>
        <indoorArea startNode="indoorAreaStart01" widthNode="indoorAreaWidth01" heightNode="indoorAreaHeight01"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateAreaStart01" endNode="tipOcclusionUpdateAreaEnd01"/>
        </updateAreas>
    </ai>

    <hotspots>
        <hotspot type="UNLOADING_PALLET" linkNode="unloadTriggerMarker" teleportNode="unloadTriggerMarker"/>
    </hotspots>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerMarker" adjustToGround="true" filename="$data/shared/assets/marker/markerIconPallet.i3d"/>
        <triggerMarker node="warningStripes01"/>
    </triggerMarkers>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="gbwProcessSupplyAdditiveDispatch" name="$l10n_production_gbwProcessSupplyAdditiveDispatch" cyclesPerHour="60" costsPerActiveHour="1">
                <inputs><input fillType="SILAGE_ADDITIVE" amount="1"/></inputs>
                <outputs><output fillType="SILAGE_ADDITIVE" amount="1"/></outputs>
            </production>
            <production id="gbwProcessSupplyMolassesDispatch" name="$l10n_production_gbwProcessSupplyMolassesDispatch" cyclesPerHour="60" costsPerActiveHour="1">
                <inputs><input fillType="MOLASSES" amount="100"/></inputs>
                <outputs><output fillType="MOLASSES" amount="100"/></outputs>
            </production>
        </productions>

        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="false" allowMissions="false">
            <palletTrigger triggerNode="palletTrigger" aiNode="unloadTriggerAINode" fillTypes="SILAGE_ADDITIVE MOLASSES"/>
        </sellingStation>

        <storage isExtension="false" fillLevelSyncThreshold="100">
            <capacity fillType="SILAGE_ADDITIVE" capacity="5000"/>
            <capacity fillType="MOLASSES" capacity="50000"/>
        </storage>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="indoorAreaStart01" node="0>0|0"/>
        <i3dMapping id="indoorAreaWidth01" node="0>0|0|0"/>
        <i3dMapping id="indoorAreaHeight01" node="0>0|0|1"/>
        <i3dMapping id="tipOcclusionUpdateAreaStart01" node="0>1|0"/>
        <i3dMapping id="tipOcclusionUpdateAreaEnd01" node="0>1|0|0"/>
        <i3dMapping id="sellingStation" node="0>2"/>
        <i3dMapping id="unloadTriggerMarker" node="0>2|1"/>
        <i3dMapping id="unloadTriggerAINode" node="0>2|2"/>
        <i3dMapping id="palletTrigger" node="0>2|4"/>
        <i3dMapping id="warningStripes01" node="0>3|0"/>
    </i3dMappings>
</placeable>
