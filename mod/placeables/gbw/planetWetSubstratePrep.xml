<?xml version="1.0" encoding="utf-8" standalone="no"?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_gbwPlanetWetSubstratePrep</name>
        <functions>
            <function>$l10n_function_gbwPlanetWetSubstratePrep</function>
        </functions>
        <image>$moddir$FS25_PlanET_BGA_Modular/storeIcon/store_PlanET_BunkerKlein.dds</image>
        <price>56000</price>
        <dailyUpkeep>24</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PLANET</brand>
        <species>PLACEABLE</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>gbwBgaProduction</tab>
        </brush>
    </storeData>

    <base>
        <filename>$moddir$FS25_PlanET_BGA_Modular/i3d/PlanET_Bunker_Klein.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End"/>
        </testAreas>
        <sounds>
            <place template="smallImp" pitchScale="1.4"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerMixerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" id="UNLOAD" adjustToGround="false"/>
        <triggerMarker node="loadTriggerMarker" filename="$data/shared/assets/marker/markerIconLoad.i3d" id="LOAD" adjustToGround="true"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" id="WRENCH" adjustToGround="true"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="hotspotMarker" teleportNode="teleportNode"/>
    </hotspots>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="gbwWetPrepSugarbeetCutToSweetMash" name="$l10n_production_gbwSugarbeetCutToSweetMash" cyclesPerHour="12" costsPerActiveHour="2.5">
                <inputs><input fillType="SUGARBEET_CUT" amount="200"/></inputs>
                <outputs><output fillType="GBW_SWEET_MASH" amount="200"/></outputs>
            </production>
            <production id="gbwWetPrepSugarcaneToSweetMash" name="$l10n_production_gbwSugarcaneToSweetMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="SUGARCANE" amount="200"/></inputs>
                <outputs><output fillType="GBW_SWEET_MASH" amount="170"/></outputs>
            </production>
            <production id="gbwWetPrepPotatoToRootMash" name="$l10n_production_gbwPotatoToRootMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="POTATO" amount="200"/></inputs>
                <outputs><output fillType="GBW_ROOT_MASH" amount="150"/></outputs>
            </production>
            <production id="gbwWetPrepBeetrootToRootMash" name="$l10n_production_gbwBeetrootToRootMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="BEETROOT" amount="200"/></inputs>
                <outputs><output fillType="GBW_ROOT_MASH" amount="150"/></outputs>
            </production>
            <production id="gbwWetPrepCarrotToRootMash" name="$l10n_production_gbwCarrotToRootMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="CARROT" amount="200"/></inputs>
                <outputs><output fillType="GBW_ROOT_MASH" amount="150"/></outputs>
            </production>
            <production id="gbwWetPrepParsnipToRootMash" name="$l10n_production_gbwParsnipToRootMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="PARSNIP" amount="200"/></inputs>
                <outputs><output fillType="GBW_ROOT_MASH" amount="150"/></outputs>
            </production>
            <production id="gbwWetPrepSpinachToGreenMash" name="$l10n_production_gbwSpinachToGreenMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="SPINACH" amount="200"/></inputs>
                <outputs><output fillType="GBW_GREEN_MASH" amount="130"/></outputs>
            </production>
            <production id="gbwWetPrepPeaToGreenMash" name="$l10n_production_gbwPeaToGreenMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="PEA" amount="200"/></inputs>
                <outputs><output fillType="GBW_GREEN_MASH" amount="140"/></outputs>
            </production>
            <production id="gbwWetPrepGreenBeanToGreenMash" name="$l10n_production_gbwGreenBeanToGreenMash" cyclesPerHour="8" costsPerActiveHour="3">
                <inputs><input fillType="GREENBEAN" amount="200"/></inputs>
                <outputs><output fillType="GBW_GREEN_MASH" amount="140"/></outputs>
            </production>
            <production id="gbwWetPrepSweetMashToPlanetBeet" name="$l10n_production_gbwSweetMashToPlanetBeet" cyclesPerHour="10" costsPerActiveHour="2.5">
                <inputs><input fillType="GBW_SWEET_MASH" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="180"/></outputs>
            </production>
            <production id="gbwWetPrepSweetMashAdditiveToPlanetBeet" name="$l10n_production_gbwSweetMashAdditiveToPlanetBeet" cyclesPerHour="12" costsPerActiveHour="3">
                <inputs>
                    <input fillType="GBW_SWEET_MASH" amount="200"/>
                    <input fillType="SILAGE_ADDITIVE" amount="0.05"/>
                </inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="200"/></outputs>
            </production>
            <production id="gbwWetPrepRootMashToPlanetBeet" name="$l10n_production_gbwRootMashToPlanetBeet" cyclesPerHour="10" costsPerActiveHour="2.5">
                <inputs><input fillType="GBW_ROOT_MASH" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="180"/></outputs>
            </production>
            <production id="gbwWetPrepRootMashAdditiveToPlanetBeet" name="$l10n_production_gbwRootMashAdditiveToPlanetBeet" cyclesPerHour="12" costsPerActiveHour="3">
                <inputs>
                    <input fillType="GBW_ROOT_MASH" amount="200"/>
                    <input fillType="SILAGE_ADDITIVE" amount="0.05"/>
                </inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="200"/></outputs>
            </production>
            <production id="gbwWetPrepGreenMashToPlanetBeet" name="$l10n_production_gbwGreenMashToPlanetBeet" cyclesPerHour="10" costsPerActiveHour="2.5">
                <inputs><input fillType="GBW_GREEN_MASH" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="180"/></outputs>
            </production>
            <production id="gbwWetPrepGreenMashAdditiveToPlanetBeet" name="$l10n_production_gbwGreenMashAdditiveToPlanetBeet" cyclesPerHour="12" costsPerActiveHour="3">
                <inputs>
                    <input fillType="GBW_GREEN_MASH" amount="200"/>
                    <input fillType="SILAGE_ADDITIVE" amount="0.05"/>
                </inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="200"/></outputs>
            </production>
            <production id="gbwWetPrepResidueMashToPlanetBeet" name="$l10n_production_gbwResidueMashToPlanetBeet" cyclesPerHour="10" costsPerActiveHour="2.5">
                <inputs><input fillType="GBW_RESIDUE_MASH" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="180"/></outputs>
            </production>
            <production id="gbwWetPrepResidueMashAdditiveToPlanetBeet" name="$l10n_production_gbwResidueMashAdditiveToPlanetBeet" cyclesPerHour="12" costsPerActiveHour="3">
                <inputs>
                    <input fillType="GBW_RESIDUE_MASH" amount="200"/>
                    <input fillType="SILAGE_ADDITIVE" amount="0.05"/>
                </inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="200"/></outputs>
            </production>
        </productions>

        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="false" allowMissions="false">
            <unloadTrigger exactFillRootNode="unloadTriggerMixer" fillTypes="SUGARBEET_CUT SUGARCANE POTATO BEETROOT CARROT PARSNIP SPINACH PEA GREENBEAN GBW_SWEET_MASH GBW_ROOT_MASH GBW_GREEN_MASH GBW_RESIDUE_MASH SILAGE_ADDITIVE"/>
            <baleTrigger triggerNode="baleTrigger" fillTypes="SUGARBEET_CUT"/>
        </sellingStation>

        <loadingStation supportsExtension="false">
            <loadTrigger triggerNode="loadTrigger" fillTypes="GBW_SWEET_MASH GBW_ROOT_MASH GBW_GREEN_MASH GBW_RESIDUE_MASH SUGARBEETCUT_IN" aiNode="loadTriggerAiNode"/>
        </loadingStation>

        <storage isExtension="false" fillLevelSyncThreshold="100">
            <capacity fillType="SUGARBEET_CUT" capacity="40000"/>
            <capacity fillType="SUGARCANE" capacity="40000"/>
            <capacity fillType="POTATO" capacity="40000"/>
            <capacity fillType="BEETROOT" capacity="40000"/>
            <capacity fillType="CARROT" capacity="40000"/>
            <capacity fillType="PARSNIP" capacity="40000"/>
            <capacity fillType="SPINACH" capacity="40000"/>
            <capacity fillType="PEA" capacity="40000"/>
            <capacity fillType="GREENBEAN" capacity="40000"/>
            <capacity fillType="GBW_SWEET_MASH" capacity="80000"/>
            <capacity fillType="GBW_ROOT_MASH" capacity="80000"/>
            <capacity fillType="GBW_GREEN_MASH" capacity="80000"/>
            <capacity fillType="GBW_RESIDUE_MASH" capacity="80000"/>
            <capacity fillType="SILAGE_ADDITIVE" capacity="120"/>
            <capacity fillType="SUGARBEETCUT_IN" capacity="80000"/>

            <dynamicFillPlane node="bunkerFillVolume" allSidePlanes="false" maxAllowedHeapAngle="10" maxDelta="0.2" defaultFillType="SUGARBEET_CUT"/>
        </storage>

        <playerTrigger node="playerTrigger"/>

        <sounds>
            <idle template="dairyIdle" linkNode="0>" outerRadius="10" volumeScale="0.2"/>
            <active template="dairyWork" linkNode="0>" outerRadius="10" volumeScale="0.3"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearArea1Start" node="0>0|0"/>
        <i3dMapping id="clearArea1Width" node="0>0|0|0"/>
        <i3dMapping id="clearArea1Height" node="0>0|0|1"/>
        <i3dMapping id="indoorArea1Start" node="0>1|0"/>
        <i3dMapping id="indoorArea1Width" node="0>1|0|0"/>
        <i3dMapping id="indoorArea1Height" node="0>1|0|1"/>
        <i3dMapping id="testArea1Start" node="0>2|0"/>
        <i3dMapping id="testArea1End" node="0>2|0|0"/>
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>3|0"/>
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>3|0|0"/>
        <i3dMapping id="infoTrigger" node="0>4"/>
        <i3dMapping id="hotspotMarker" node="0>9"/>
        <i3dMapping id="teleportNode" node="0>10"/>
        <i3dMapping id="loadTrigger" node="0>11|0|0"/>
        <i3dMapping id="loadTriggerMarker" node="0>11|0|1"/>
        <i3dMapping id="loadTriggerAiNode" node="0>11|0|2"/>
        <i3dMapping id="bunkerFillVolume" node="0>11|2|0"/>
        <i3dMapping id="baleTrigger" node="0>11|2|1"/>
        <i3dMapping id="unloadTriggerMixer" node="0>11|2|2"/>
        <i3dMapping id="unloadTriggerMixerMarker" node="0>11|2|3"/>
        <i3dMapping id="playerTrigger" node="0>11|4"/>
        <i3dMapping id="playerTriggerMarker" node="0>11|4|0"/>
    </i3dMappings>
</placeable>
