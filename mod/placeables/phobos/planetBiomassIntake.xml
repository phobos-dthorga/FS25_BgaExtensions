        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="false" allowMissions="false">
            <unloadTrigger exactFillRootNode="unloadTriggerMixer" fillTypes="CHAFF SILAGE GRASS_WINDROW DRYGRASS_WINDROW STRAW MANURE SUGARBEET_CUT SUGARCANE POTATO BEETROOT CARROT PARSNIP SPINACH PEA GREENBEAN PHB_WET_BIOMASS_MASH"/>
            <unloadTrigger exactFillRootNode="unloadTriggerLiquidManure" fillTypes="LIQUIDMANURE" aiNode="unloadTriggerLiquidManureAiNode"/>
            <baleTrigger triggerNode="baleTrigger" fillTypes="CHAFF SILAGE GRASS_WINDROW DRYGRASS_WINDROW STRAW SUGARBEET_CUT"/>

            <unloadTrigger exactFillRootNode="unloadTriggerInFront" fillTypes="CHAFF SILAGE GRASS_WINDROW DRYGRASS_WINDROW STRAW MANURE SUGARBEET_CUT SUGARCANE POTATO BEETROOT CARROT PARSNIP SPINACH PEA GREENBEAN PHB_WET_BIOMASS_MASH" aiNode="unloadTriggerInFrontAINode"/>
            <baleTrigger triggerNode="baleTriggerInFront" fillTypes="CHAFF SILAGE GRASS_WINDROW DRYGRASS_WINDROW STRAW SUGARBEET_CUT"/>

            <animationNodes>
                <animationNode node="mixingDrum" rotAxis="2" rotSpeed="-80"/>
            </animationNodes>
        </sellingStation>

        <loadingStation supportsExtension="false">
            <loadTrigger triggerNode="loadTrigger" fillTypes="SILAGE_IN MANURE_IN PHB_WET_BIOMASS_MASH SUGARBEETCUT_IN LIQUIDMANURE1 STRAW_PELLETS" aiNode="loadTriggerAiNode"/>
