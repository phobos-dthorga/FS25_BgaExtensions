            <capacity fillType="GREENBEAN" capacity="15000"/>
            <capacity fillType="SILAGE_IN" capacity="100000"/>
            <capacity fillType="MANURE_IN" capacity="50000"/>
            <capacity fillType="PHB_WET_BIOMASS_MASH" capacity="50000"/>
            <capacity fillType="SUGARBEETCUT_IN" capacity="50000"/>
            <capacity fillType="LIQUIDMANURE1" capacity="50000"/>
            <capacity fillType="STRAW_PELLETS" capacity="25000"/>

            <dynamicFillPlane node="bunkerFillVolume" allSidePlanes="false" maxAllowedHeapAngle="10" maxDelta="0.2" defaultFillType="CHAFF"/>
