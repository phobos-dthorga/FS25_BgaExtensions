<?xml version="1.0" encoding="utf-8" standalone="no"?>
<placeable type="productionPoint" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_storeItem_phobosPlanetBiomassIntakeMedium</name>
        <functions>
            <function>$l10n_function_phobosPlanetSolidBiomassIntake</function>
        </functions>
        <image>$moddir$FS25_PlanET_BGA_Modular/storeIcon/store_PlanET_BunkerMittel.dds</image>
        <price>88000</price>
        <dailyUpkeep>35</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>PLANET</brand>
        <species>placeable</species>
        <category>productionPoints</category>
        <brush>
            <type>placeable</type>
            <category>production</category>
            <tab>factories</tab>
        </brush>
    </storeData>

    <base>
        <filename>$moddir$FS25_PlanET_BGA_Modular/i3d/PlanET_Bunker_Mittel.i3d</filename>
        <canBeRenamed>true</canBeRenamed>
        <boughtWithFarmland>true</boughtWithFarmland>
    </base>

    <placement useRandomYRotation="false" useManualYRotation="true">
        <testAreas>
            <testArea startNode="testArea1Start" endNode="testArea1End"/>
        </testAreas>
        <sounds>
            <place template="smallImp" pitchScale="1.4"/>
        </sounds>
    </placement>

    <clearAreas>
        <clearArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height"/>
    </clearAreas>

    <leveling requireLeveling="true" maxSmoothDistance="10" maxSlope="75" maxEdgeAngle="30">
        <levelAreas>
            <levelArea startNode="clearArea1Start" widthNode="clearArea1Width" heightNode="clearArea1Height" groundType="asphalt"/>
        </levelAreas>
    </leveling>

    <indoorAreas>
        <indoorArea startNode="indoorArea1Start" widthNode="indoorArea1Width" heightNode="indoorArea1Height"/>
    </indoorAreas>

    <tipOcclusionUpdateAreas>
        <tipOcclusionUpdateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
    </tipOcclusionUpdateAreas>

    <ai>
        <updateAreas>
            <updateArea startNode="tipOcclusionUpdateArea1Start" endNode="tipOcclusionUpdateArea1End"/>
        </updateAreas>
    </ai>

    <infoTrigger triggerNode="infoTrigger"/>

    <triggerMarkers>
        <triggerMarker node="unloadTriggerMixerMarker" filename="$data/shared/assets/marker/markerIconUnload.i3d" id="UNLOAD" adjustToGround="false"/>
        <triggerMarker node="loadTriggerMarker" filename="$data/shared/assets/marker/markerIconLoad.i3d" id="LOAD" adjustToGround="true"/>
        <triggerMarker node="playerTriggerMarker" filename="$data/shared/assets/marker/markerIconWrench.i3d" id="WRENCH" adjustToGround="true"/>
    </triggerMarkers>

    <hotspots>
        <hotspot type="PRODUCTION_POINT" linkNode="hotspotMarker" teleportNode="teleportNode"/>
    </hotspots>

    <productionPoint>
        <productions sharedThroughputCapacity="false">
            <production id="phbMediumChaffToPlanetSilage" name="$l10n_production_phbChaffToPlanetSilage" cyclesPerHour="12" costsPerActiveHour="3">
                <inputs><input fillType="CHAFF" amount="840"/></inputs>
                <outputs><output fillType="SILAGE_IN" amount="840"/></outputs>
            </production>
            <production id="phbMediumChaffAdditiveToPlanetSilage" name="$l10n_production_phbChaffAdditiveToPlanetSilage" cyclesPerHour="12" costsPerActiveHour="3.5">
                <inputs>
                    <input fillType="CHAFF" amount="840"/>
                    <input fillType="SILAGE_ADDITIVE" amount="0.1"/>
                </inputs>
                <outputs><output fillType="SILAGE_IN" amount="910"/></outputs>
            </production>
            <production id="phbMediumSilageToPlanetSilage" name="$l10n_production_phbSilageToPlanetSilage" cyclesPerHour="15" costsPerActiveHour="2.5">
                <inputs><input fillType="SILAGE" amount="840"/></inputs>
                <outputs><output fillType="SILAGE_IN" amount="840"/></outputs>
            </production>
            <production id="phbMediumGrassToPlanetSilage" name="$l10n_production_phbGrassToPlanetSilage" cyclesPerHour="9" costsPerActiveHour="3">
                <inputs><input fillType="GRASS_WINDROW" amount="840"/></inputs>
                <outputs><output fillType="SILAGE_IN" amount="650"/></outputs>
            </production>
            <production id="phbMediumGrassAdditiveToPlanetSilage" name="$l10n_production_phbGrassAdditiveToPlanetSilage" cyclesPerHour="9" costsPerActiveHour="3.5">
                <inputs>
                    <input fillType="GRASS_WINDROW" amount="840"/>
                    <input fillType="SILAGE_ADDITIVE" amount="0.1"/>
                </inputs>
                <outputs><output fillType="SILAGE_IN" amount="720"/></outputs>
            </production>
            <production id="phbMediumHayToPlanetSilage" name="$l10n_production_phbHayToPlanetSilage" cyclesPerHour="9" costsPerActiveHour="3">
                <inputs><input fillType="DRYGRASS_WINDROW" amount="840"/></inputs>
                <outputs><output fillType="SILAGE_IN" amount="720"/></outputs>
            </production>
            <production id="phbMediumStrawToPlanetSilage" name="$l10n_production_phbStrawToPlanetSilage" cyclesPerHour="6" costsPerActiveHour="4">
                <inputs><input fillType="STRAW" amount="840"/></inputs>
                <outputs><output fillType="SILAGE_IN" amount="420"/></outputs>
            </production>
            <production id="phbMediumStrawToPellets" name="$l10n_production_phbStrawToPellets" cyclesPerHour="8" costsPerActiveHour="6">
                <inputs><input fillType="STRAW" amount="1000"/></inputs>
                <outputs><output fillType="STRAW_PELLETS" amount="250"/></outputs>
            </production>
            <production id="phbMediumManureToPlanetManure" name="$l10n_production_phbManureToPlanetManure" cyclesPerHour="15" costsPerActiveHour="2.5">
                <inputs><input fillType="MANURE" amount="400"/></inputs>
                <outputs><output fillType="MANURE_IN" amount="400"/></outputs>
            </production>
            <production id="phbMediumSugarbeetCutToPlanetBeet" name="$l10n_production_phbSugarbeetCutToPlanetBeet" cyclesPerHour="15" costsPerActiveHour="2.5">
                <inputs><input fillType="SUGARBEET_CUT" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="200"/></outputs>
            </production>
            <production id="phbMediumSugarcaneToPlanetBeet" name="$l10n_production_phbSugarcaneToPlanetBeet" cyclesPerHour="9" costsPerActiveHour="3">
                <inputs><input fillType="SUGARCANE" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="170"/></outputs>
            </production>
            <production id="phbMediumPotatoToPlanetBeet" name="$l10n_production_phbPotatoToPlanetBeet" cyclesPerHour="9" costsPerActiveHour="3">
                <inputs><input fillType="POTATO" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="150"/></outputs>
            </production>
            <production id="phbMediumBeetrootToPlanetBeet" name="$l10n_production_phbBeetrootToPlanetBeet" cyclesPerHour="9" costsPerActiveHour="3">
                <inputs><input fillType="BEETROOT" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="150"/></outputs>
            </production>
            <production id="phbMediumCarrotToPlanetBeet" name="$l10n_production_phbCarrotToPlanetBeet" cyclesPerHour="9" costsPerActiveHour="3">
                <inputs><input fillType="CARROT" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="150"/></outputs>
            </production>
            <production id="phbMediumParsnipToPlanetBeet" name="$l10n_production_phbParsnipToPlanetBeet" cyclesPerHour="9" costsPerActiveHour="3">
                <inputs><input fillType="PARSNIP" amount="200"/></inputs>
                <outputs><output fillType="SUGARBEETCUT_IN" amount="150"/></outputs>
            </production>
        </productions>

        <sellingStation node="sellingStation" appearsOnStats="false" supportsExtension="false" allowMissions="false">
            <unloadTrigger exactFillRootNode="unloadTriggerMixer" fillTypes="CHAFF SILAGE GRASS_WINDROW DRYGRASS_WINDROW STRAW MANURE SUGARBEET_CUT SUGARCANE POTATO BEETROOT CARROT PARSNIP SILAGE_ADDITIVE"/>
            <baleTrigger triggerNode="baleTrigger" fillTypes="CHAFF SILAGE GRASS_WINDROW DRYGRASS_WINDROW STRAW SUGARBEET_CUT"/>
        </sellingStation>

        <loadingStation supportsExtension="false">
            <loadTrigger triggerNode="loadTrigger" fillTypes="SILAGE_IN MANURE_IN SUGARBEETCUT_IN STRAW_PELLETS" aiNode="loadTriggerAiNode"/>
        </loadingStation>

        <storage isExtension="false" fillLevelSyncThreshold="100">
            <capacity fillType="CHAFF" capacity="60000"/>
            <capacity fillType="SILAGE" capacity="60000"/>
            <capacity fillType="GRASS_WINDROW" capacity="60000"/>
            <capacity fillType="DRYGRASS_WINDROW" capacity="60000"/>
            <capacity fillType="STRAW" capacity="30000"/>
            <capacity fillType="MANURE" capacity="25000"/>
            <capacity fillType="SUGARBEET_CUT" capacity="20000"/>
            <capacity fillType="SUGARCANE" capacity="20000"/>
            <capacity fillType="POTATO" capacity="20000"/>
            <capacity fillType="BEETROOT" capacity="20000"/>
            <capacity fillType="CARROT" capacity="20000"/>
            <capacity fillType="PARSNIP" capacity="20000"/>
            <capacity fillType="SILAGE_ADDITIVE" capacity="120"/>
            <capacity fillType="SILAGE_IN" capacity="80000"/>
            <capacity fillType="MANURE_IN" capacity="25000"/>
            <capacity fillType="SUGARBEETCUT_IN" capacity="40000"/>
            <capacity fillType="STRAW_PELLETS" capacity="20000"/>

            <dynamicFillPlane node="bunkerFillVolume" allSidePlanes="false" maxAllowedHeapAngle="10" maxDelta="0.2" defaultFillType="SILAGE"/>
        </storage>

        <playerTrigger node="playerTrigger"/>

        <sounds>
            <idle template="dairyIdle" linkNode="0>" outerRadius="10" volumeScale="0.2"/>
            <active template="dairyWork" linkNode="0>" outerRadius="10" volumeScale="0.3"/>
        </sounds>
    </productionPoint>

    <i3dMappings>
        <i3dMapping id="clearArea1Start" node="0>0|0"/>
        <i3dMapping id="clearArea1Width" node="0>0|0|0"/>
        <i3dMapping id="clearArea1Height" node="0>0|0|1"/>
        <i3dMapping id="indoorArea1Start" node="0>1|0"/>
        <i3dMapping id="indoorArea1Width" node="0>1|0|0"/>
        <i3dMapping id="indoorArea1Height" node="0>1|0|1"/>
        <i3dMapping id="testArea1Start" node="0>2|0"/>
        <i3dMapping id="testArea1End" node="0>2|0|0"/>
        <i3dMapping id="tipOcclusionUpdateArea1Start" node="0>3|0"/>
        <i3dMapping id="tipOcclusionUpdateArea1End" node="0>3|0|0"/>
        <i3dMapping id="infoTrigger" node="0>4"/>
        <i3dMapping id="hotspotMarker" node="0>9"/>
        <i3dMapping id="teleportNode" node="0>10"/>
        <i3dMapping id="loadTrigger" node="0>11|0|0"/>
        <i3dMapping id="loadTriggerMarker" node="0>11|0|1"/>
        <i3dMapping id="loadTriggerAiNode" node="0>11|0|2"/>
        <i3dMapping id="bunkerFillVolume" node="0>11|2|0"/>
        <i3dMapping id="baleTrigger" node="0>11|2|1"/>
        <i3dMapping id="unloadTriggerMixer" node="0>11|2|2"/>
        <i3dMapping id="unloadTriggerMixerMarker" node="0>11|2|3"/>
        <i3dMapping id="playerTrigger" node="0>11|4"/>
        <i3dMapping id="playerTriggerMarker" node="0>11|4|0"/>
    </i3dMappings>
</placeable>
