    <version>0.2.9.0</version>
    <title>
        <en>FS25 BGA Extensions</en>
    </title>
    <description>
        <en>Early staging mod for extending Farming Simulator 25 biogas plant gameplay. Adds modular PlanET-compatible biomass intakes, wet substrate prep, straw pellet routing, and dry fuel yard storage for heat-plant logistics.</en>
    </description>
    <iconFilename>icon.dds</iconFilename>

