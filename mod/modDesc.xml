<?xml version="1.0" encoding="utf-8" standalone="no"?>
<modDesc descVersion="107" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://validation.gdn.giants-software.com/xml/fs25/modDesc.xsd">
    <author>phobosgekko</author>
    <version>0.1.0.0</version>
    <title>
        <en>FS25 BGA Extensions</en>
    </title>
    <description>
        <en>Early staging mod for extending Farming Simulator 25 biogas plant gameplay. The proof of concept adds a PlanET-compatible biomass intake with straw pellet routing for the Straw Harvest pellet heat plant.</en>
    </description>
    <iconFilename>icon.dds</iconFilename>

    <l10n>
        <text name="storeItem_phobosPlanetBiomassIntake">
            <en>Phobos PlanET Energy Yard Intake</en>
        </text>
        <text name="function_phobosPlanetBiomassIntake">
            <en>Converts additional biomass into PlanET BGA feedstock or pellet fuel.</en>
        </text>
        <text name="production_phbChaffToPlanetSilage">
            <en>Chaff substrate</en>
        </text>
        <text name="production_phbGrassToPlanetSilage">
            <en>Fresh grass substrate</en>
        </text>
        <text name="production_phbHayToPlanetSilage">
            <en>Hay substrate</en>
        </text>
        <text name="production_phbStrawToPlanetSilage">
            <en>Straw pretreatment</en>
        </text>
        <text name="production_phbStrawToPellets">
            <en>Straw pelletizing</en>
        </text>
        <text name="production_phbSugarbeetCutToPlanetBeet">
            <en>Beet pulp intake</en>
        </text>
        <text name="production_phbPotatoToPlanetBeet">
            <en>Potato mash</en>
        </text>
        <text name="production_phbBeetrootToPlanetBeet">
            <en>Beetroot mash</en>
        </text>
        <text name="production_phbCarrotToPlanetBeet">
            <en>Carrot mash</en>
        </text>
        <text name="production_phbParsnipToPlanetBeet">
            <en>Parsnip mash</en>
        </text>
    </l10n>

    <dependencies>
        <dependency>FS25_PlanET_BGA_Modular</dependency>
        <dependency>pdlc_strawHarvestPack</dependency>
    </dependencies>

    <multiplayer supported="true"/>

    <storeItems>
        <storeItem xmlFilename="placeables/phobos/planetBiomassIntake.xml"/>
    </storeItems>
</modDesc>
